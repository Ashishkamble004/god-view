{
  "hooks": {
    "PreToolUse": [
      {
        "tool_match": "logging.query",
        "commands": [
          "python3 scripts/check_error_rate.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "tool_match": "logging.query",
        "commands": [
          "python3 scripts/check_error_rate.py",
          "python3 scripts/check_payload_schema.py"
        ]
      }
    ],
    "Stop": [
      {
        "commands": [
          "python3 scripts/check_error_rate.py",
          "python3 scripts/check_payload_schema.py"
        ]
      }
    ]
  }
}
