{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "obs.*",
        "commands": [
          "python3 scripts/check_cibil_score_offsets.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "commands": [
          "python3 scripts/check_cibil_score_offsets.py",
          "python3 scripts/check_prompt_drift_cusum.py"
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "commands": [
          "python3 scripts/check_cibil_score_offsets.py",
          "python3 scripts/check_prompt_drift_cusum.py"
        ]
      }
    ]
  }
}
