{
  "hooks": {
    "PreToolUse": [
      {
        "tool_match": "pubsub.dlq_depth",
        "commands": [
          "python3 scripts/check_queue_backlog.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "tool_match": "pubsub.dlq_depth",
        "commands": [
          "python3 scripts/check_queue_backlog.py",
          "python3 scripts/check_step_sequence.py"
        ]
      }
    ],
    "Stop": [
      {
        "commands": [
          "python3 scripts/check_queue_backlog.py",
          "python3 scripts/check_step_sequence.py"
        ]
      }
    ]
  }
}
