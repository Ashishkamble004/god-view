{
  "hooks": {
    "PreToolUse": [
      {
        "tool_match": "git.list_commits",
        "commands": [
          "python3 scripts/check_commit_regression.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "tool_match": "git.list_commits",
        "commands": [
          "python3 scripts/check_commit_regression.py",
          "python3 scripts/check_config_drift.py"
        ]
      }
    ],
    "Stop": [
      {
        "commands": [
          "python3 scripts/check_commit_regression.py",
          "python3 scripts/check_config_drift.py"
        ]
      }
    ]
  }
}
