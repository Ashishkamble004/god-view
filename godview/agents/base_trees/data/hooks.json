{
  "hooks": {
    "PreToolUse": [
      {
        "tool_match": "sql.list_active_queries",
        "commands": [
          "python3 scripts/check_query_latency.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "tool_match": "sql.list_active_queries",
        "commands": [
          "python3 scripts/check_query_latency.py",
          "python3 scripts/check_distribution_shift.py"
        ]
      }
    ],
    "Stop": [
      {
        "commands": [
          "python3 scripts/check_query_latency.py",
          "python3 scripts/check_distribution_shift.py"
        ]
      }
    ]
  }
}
