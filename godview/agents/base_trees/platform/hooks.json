{
  "hooks": {
    "PreToolUse": [
      {
        "tool_match": "k8s.get_resource",
        "commands": [
          "python3 scripts/check_container_restart.py"
        ]
      }
    ],
    "PostToolUse": [
      {
        "tool_match": "k8s.get_resource",
        "commands": [
          "python3 scripts/check_container_restart.py",
          "python3 scripts/check_resource_limits.py"
        ]
      }
    ],
    "Stop": [
      {
        "commands": [
          "python3 scripts/check_container_restart.py",
          "python3 scripts/check_resource_limits.py"
        ]
      }
    ]
  }
}
