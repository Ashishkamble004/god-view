          "journey_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Id"
          },
          "cibil_stub_900": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cibil Stub 900"
          },
          "gce_vm_latency_504": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gce Vm Latency 504"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "ScoreRequest"
      },
      "ScoreResponse": {
        "properties": {
          "cibil_score": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 300.0,
            "title": "Cibil Score"
          },
          "cibil_bureau_ref": {
            "type": "string",
            "title": "Cibil Bureau Ref"
          },
          "gce_vm_name": {
            "type": "string",
            "title": "Gce Vm Name"
          },
          "pan_number": {
            "type": "string",
            "title": "Pan Number"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "default": "cibil.scored"
          }
        },
        "type": "object",
        "required": [
          "cibil_score",
          "cibil_bureau_ref",
          "gce_vm_name",
          "pan_number"
        ],
        "title": "ScoreResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
