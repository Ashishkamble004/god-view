            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Disbursed Amount Inr"
          },
          "dealer_account_no": {
            "type": "string",
            "title": "Dealer Account No"
          },
          "status": {
            "$ref": "#/components/schemas/DisbursementStatus"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "replay_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Of"
          },
          "disbursed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disbursed At"
          },
          "cibil_score": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 300.0,
            "title": "Cibil Score"
          },
          "cibil_bureau_ref": {
            "type": "string",
            "title": "Cibil Bureau Ref"
          },
          "gce_vm_name": {
            "type": "string",
            "title": "Gce Vm Name"
          },
          "idempotent_replay": {
            "type": "boolean",
            "title": "Idempotent Replay",
            "default": false
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "default": "disbursement.settled"
          }
        },
        "type": "object",
        "required": [
          "disbursement_id",
          "loan_id",
          "sanction_letter_no",
          "nach_mandate_id",
          "disbursed_amount_inr",
          "dealer_account_no",
          "status",
          "attempts",
          "cibil_score",
          "cibil_bureau_ref",
          "gce_vm_name"
        ],
        "title": "DisburseResponse"
      },
      "DisbursementStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "DISBURSED",
          "FAILED",
          "REPLAYED"
        ],
        "title": "DisbursementStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
