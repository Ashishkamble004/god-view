  "components": {
    "schemas": {
      "DisburseRequest": {
        "properties": {
          "loan_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Loan Id"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "journey_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Id"
          },
          "pan_number": {
            "type": "string",
            "title": "Pan Number",
            "default": "ABCDE1234F"
          },
          "persona_seed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona Seed"
          },
          "disbursed_amount_inr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Disbursed Amount Inr",
            "default": "500000.00"
          },
          "dealer_account_no": {
            "type": "string",
            "title": "Dealer Account No",
            "default": "CYMBAL-DLR-0001"
          },
          "disburse": {
            "type": "boolean",
            "title": "Disburse",
            "default": true
          },
          "is_replay": {
            "type": "boolean",
            "title": "Is Replay",
            "default": false
          },
          "target_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DisbursementStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "cibil_stub_900": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cibil Stub 900"
          },
          "gce_vm_latency_504": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gce Vm Latency 504"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "loan_id"
        ],
        "title": "DisburseRequest"
      },
