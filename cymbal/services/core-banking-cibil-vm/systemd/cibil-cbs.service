[Unit]
Description=Cymbal Auto Finance Utility 5 — Credit Bureau (CIBIL) & Core Banking Settlement (CBS) Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cibilcbs
Group=cibilcbs
WorkingDirectory=/opt/cibil-cbs
EnvironmentFile=-/etc/default/cibil-cbs
Environment="SERVICE_NAME=core-banking-cibil-vm"
Environment="PORT=8085"
Environment="GODVIEW_ENV=gcp"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=+/opt/cibil-cbs/.venv/bin/python /opt/cibil-cbs/cibil_cbs/env_sync.py
ExecStart=/opt/cibil-cbs/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8085 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
