{
  "openapi": "3.1.0",
  "info": {
    "title": "Cymbal Auto Finance \u2014 Commercial Fleet & Two-Wheeler Credit Line Service (Utility 3)",
    "description": "Working-capital commercial fleet credit lines and two-wheeler micro-loans on Cloud Run port 8080.",
    "version": "4.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/fleet-credit/evaluate": {
      "post": {
        "summary": "Evaluate Fleet Credit",
        "operationId": "evaluate_fleet_credit_internal_fleet_credit_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FleetCreditEvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FleetCreditEvaluateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FleetCreditEvaluateRequest": {
        "properties": {
          "loan_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Loan Id"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Customer Id"
          },
          "journey_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Id"
          },
          "vehicle_category": {
            "type": "string",
            "enum": [
              "TWO_WHEELER",
              "COMMERCIAL_FLEET"
            ],
            "title": "Vehicle Category",
            "default": "COMMERCIAL_FLEET"
          },
          "fleet_size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Fleet Size",
            "default": 5
          },
          "requested_limit_inr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Requested Limit Inr",
            "default": "1500000.00"
          },
          "cibil_score": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 300.0,
            "title": "Cibil Score",
            "default": 750
          },
          "existing_exposure_inr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Existing Exposure Inr",
            "default": "0.00"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "loan_id",
          "customer_id"
        ],
        "title": "FleetCreditEvaluateRequest"
      },
      "FleetCreditEvaluateResponse": {
        "properties": {
          "credit_line_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Credit Line Id"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Customer Id"
          },
          "loan_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string"
              }
            ],
            "title": "Loan Id"
          },
          "vehicle_category": {
            "type": "string",
            "enum": [
              "TWO_WHEELER",
              "COMMERCIAL_FLEET"
            ],
            "title": "Vehicle Category"
          },
          "fleet_size": {
            "type": "integer",
            "title": "Fleet Size"
          },
          "requested_limit_inr": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Requested Limit Inr"
          },
          "sanctioned_limit_inr": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Sanctioned Limit Inr"
          },
          "utilisation_pct": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Utilisation Pct"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "evaluated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluated At"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "default": "credit_line.decided"
          }
        },
        "type": "object",
        "required": [
          "credit_line_id",
          "customer_id",
          "loan_id",
          "vehicle_category",
          "fleet_size",
          "requested_limit_inr",
          "sanctioned_limit_inr",
          "utilisation_pct",
          "decision",
          "status"
        ],
        "title": "FleetCreditEvaluateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
